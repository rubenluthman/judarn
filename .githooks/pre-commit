#!/usr/bin/env bash
# Shared commit checks first (secrets, paths, links, decision records, version guard); then this repository's fast checks.
# Swift and web tests stay in ./scripts/verify_commit.sh.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
scripts/commit-checks pre-commit

node scripts/compile-tokens.js --check
node scripts/build-wada-explorer.js --check
node scripts/sync-version.js --check
