#!/bin/sh
# Shared commit checks first; this repository's own fast checks go below the marker.
root=$(git rev-parse --show-toplevel) || exit 1
"$root/scripts/commit-checks" pre-commit || exit 1
# --- repository checks ---
# Swift and web tests stay in ./scripts/verify_commit.sh.
cd "$root" || exit 1
node scripts/compile-tokens.js --check || exit 1
node scripts/build-wada-explorer.js --check || exit 1
node scripts/sync-version.js --check || exit 1
