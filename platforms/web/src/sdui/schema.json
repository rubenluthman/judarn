{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JudarnSDUINode",
  "description": "Declarative Server-Driven UI node schema for Judarn design foundation. Props are allowlisted per node type; any other prop is rejected. Mirrors SDUI_PROP_ALLOWLIST in serializer.js.",
  "type": "object",
  "required": [
    "type"
  ],
  "additionalProperties": false,
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "button",
        "badge",
        "tag",
        "card",
        "data-matrix",
        "data-table",
        "text-field",
        "container",
        "text"
      ]
    },
    "props": {
      "type": "object"
    },
    "children": {
      "type": "array",
      "items": {
        "$ref": "#"
      }
    },
    "content": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "button"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "props": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "variant": {
                "type": "string",
                "enum": [
                  "primary",
                  "outline",
                  "secondary",
                  "ghost",
                  "accent"
                ]
              },
              "size": {
                "type": "string",
                "enum": [
                  "sm",
                  "md",
                  "lg"
                ]
              },
              "block": {
                "type": "boolean"
              },
              "disabled": {
                "type": "boolean"
              },
              "type": {
                "type": "string",
                "enum": [
                  "button",
                  "submit",
                  "reset"
                ]
              },
              "token": {
                "type": "string",
                "enum": [
                  "substrate",
                  "surfaceElevated",
                  "surfaceRecessed",
                  "ink100",
                  "ink60",
                  "ink30",
                  "signalError",
                  "subtle",
                  "control",
                  "card",
                  "badge",
                  "half",
                  "1",
                  "2",
                  "3",
                  "4",
                  "6",
                  "8",
                  "12",
                  "16",
                  "touch",
                  "body",
                  "compact",
                  "sidebar"
                ]
              }
            }
          }
        }
      }
    },
